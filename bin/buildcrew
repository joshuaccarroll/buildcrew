#!/bin/bash
# BuildCrew - Autonomous AI Development Workflow
# https://github.com/joshuaccarroll/buildcrew

# Wrap entire script in a block so bash parses it fully before executing.
# This prevents syntax errors when cmd_update overwrites this file mid-run.
{

set -e

# Determine script location (follow symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
BUILDCREW_HOME="$(dirname "$SCRIPT_DIR")"
export BUILDCREW_HOME

# Source library files (common.sh first — provides colors and helpers to all)
source "$BUILDCREW_HOME/lib/common.sh"
source "$BUILDCREW_HOME/lib/version.sh"
source "$BUILDCREW_HOME/lib/update.sh"
source "$BUILDCREW_HOME/lib/plugins.sh"

print_logo() {
    echo -e "${CYAN}"
    echo "  ____        _ _     _  ____                    "
    echo " | __ ) _   _(_) | __| |/ ___|_ __ _____      __ "
    echo " |  _ \\| | | | | |/ _\` | |   | '__/ _ \\ \\ /\\ / / "
    echo " | |_) | |_| | | | (_| | |___| | |  __/\\ V  V /  "
    echo " |____/ \\__,_|_|_|\\__,_|\\____|_|  \\___| \\_/\\_/   "
    echo -e "${NC}"
}

print_help() {
    print_logo
    echo -e "${BOLD}BuildCrew${NC} - Autonomous AI Development Workflow"
    echo ""
    echo -e "${BOLD}USAGE:${NC}"
    echo "    buildcrew <command> [options]"
    echo ""
    echo -e "${BOLD}COMMANDS:${NC}"
    echo "    init [--quick]   Initialize BuildCrew in current project"
    echo "    run              Execute workflow on BACKLOG.md (execution mode)"
    echo "    plan             Launch Product Manager to plan a new project or add scope"
    echo "    status           Show backlog stats and last workflow result"
    echo "    stop             Stop workflow after current task completes"
    echo "    reset            Clear blocked tasks and clean up artifacts"
    echo "    repair           Check (and optionally fix) installation health"
    echo "    lessons          List recorded lessons"
    echo "    lessons promote  Graduate a lesson to permanent project rules"
    echo "    lessons prune    Interactively remove stale lessons"
    echo "    lessons lint     Check lessons for vague or weak rules"
    echo "    plugins          Show recommended plugins for your project"
    echo "    update           Check for and install updates"
    echo "    uat              Run blind UAT against a project's README"
    echo "    dash             Manage the buildcrew-dash terminal dashboard"
    echo "    version          Show version information"
    echo "    uninstall        Remove BuildCrew from system"
    echo "    help             Show this help message"
    echo ""
    echo -e "${BOLD}OPTIONS:${NC}"
    echo "    --single      Process only one task (with 'run')"
    echo "    --dry-run     Preview without executing (with 'run')"
    echo "    --review      Pause for human review before build, shows plan inline (with 'run')"
    echo "    --branch      Create a feature branch per task with optional PR (with 'run')"
    echo "    --resume      Resume an interrupted task from where it left off (with 'run')"
    echo "    --task N      Target a specific task by name or number (with 'run')"
    echo "    --skip-spec   Skip the specification refinement phase (with 'run')"
    echo "    --strict      (default) Require ALL acceptance criteria to pass before commit (with 'run')"
    echo "    --no-strict   Allow partial acceptance criteria pass — proceed with warnings (with 'run')"
    echo "    --max-invocations N  Max Claude invocations per run (default: 15, with 'run')"
    echo "    --full-pipeline  Force all phases regardless of complexity assessment (with 'run')"
    echo "    --auto        (deprecated) Auto mode is now the default. Use --interactive to opt out (with 'run')"
    echo "    --interactive Restore interactive review pauses (with 'run')"
    echo "    --uat         After build completes, enter watch mode for UAT verdicts (with 'run')"
    echo "    --sequential  Run tasks one at a time (opt out of parallel batch mode, with 'run')"
    echo "    --batch       (deprecated) Batch mode is now the default (with 'run')"
    echo "    --max-parallel N  Max concurrent tasks in parallel mode (default: 5, with 'run')"
    echo "    --verbose     Show orchestrator decisions, phase verdicts, and invocation counts"
    echo "    --debug       Alias for --verbose"
    echo ""
    echo -e "${BOLD}GETTING STARTED:${NC}"
    echo -e "    1. Run ${CYAN}buildcrew init${NC} in your project"
    echo -e "    2. Run ${CYAN}buildcrew run${NC} to start"
    echo -e "    (Auto-launches discovery mode if no backlog exists)"
    echo -e "    3. Run ${CYAN}buildcrew dash${NC} for a live terminal dashboard"
    echo ""
    echo -e "${BOLD}DOCUMENTATION:${NC}"
    echo "    https://github.com/joshuaccarroll/buildcrew"
    echo ""
}

_ensure_skill_symlinks() {
    local skills_dir="$BUILDCREW_HOME/skills"
    local target_dir=".claude/skills"
    local skill_path skill_name link_target

    for skill_path in "$skills_dir"/*/; do
        [ -d "$skill_path" ] || continue
        skill_name="$(basename "$skill_path")"
        local dest="$target_dir/$skill_name"

        if [ -d "$dest" ] && [ ! -L "$dest" ]; then
            # Real directory — preserve user content, skip
            continue
        elif [ -L "$dest" ]; then
            link_target="$(readlink "$dest")"
            if [ "$link_target" = "$skill_path" ] || [ "$link_target" = "${skill_path%/}" ]; then
                # Already points to correct target
                continue
            else
                # Stale symlink — replace it
                rm -f "$dest"
            fi
        fi

        ln -s "$skill_path" "$dest"
        echo -e "  ${GREEN}✓${NC} Linked skill: $skill_name"
    done
}

cmd_init() {
    local quick=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --quick) quick=1; shift ;;
            *) echo "Unknown option: $1" >&2; return 1 ;;
        esac
    done

    echo -e "${BOLD}Initializing BuildCrew in current project...${NC}"
    echo ""

    # Create .claude directory (minimal - uses global installation)
    mkdir -p .claude

    # Create .buildcrew-link marker pointing to global installation
    if [ ! -f ".claude/.buildcrew-link" ]; then
        echo "BUILDCREW_HOME=$BUILDCREW_HOME" > .claude/.buildcrew-link
        echo -e "  ${GREEN}✓${NC} Linked to BuildCrew at $BUILDCREW_HOME"
    else
        echo -e "  ${YELLOW}○${NC} BuildCrew link exists"
    fi

    # Symlink commands from global installation
    if [ ! -e ".claude/commands" ]; then
        ln -s "$BUILDCREW_HOME/commands" ".claude/commands"
        echo -e "  ${GREEN}✓${NC} Linked commands"
    else
        echo -e "  ${YELLOW}○${NC} .claude/commands exists"
    fi

    # Symlink skills from global installation
    if [ ! -e ".claude/skills" ]; then
        ln -s "$BUILDCREW_HOME/skills" ".claude/skills"
        echo -e "  ${GREEN}✓${NC} Linked skills"
    elif [ -L ".claude/skills" ]; then
        echo -e "  ${YELLOW}○${NC} .claude/skills exists"
    else
        # Real directory — link individual skill subdirectories
        _ensure_skill_symlinks
    fi

    # ─── Install playground plugin ──────────────────────────────────────────────
    if command -v claude >/dev/null 2>&1; then
        local plugins_json="$HOME/.claude/plugins/installed_plugins.json"
        if [[ -f "$plugins_json" ]] && grep -q '"playground@' "$plugins_json" 2>/dev/null; then
            echo -e "  ${YELLOW}○${NC} Playground plugin already installed"
        else
            # Ensure marketplace is registered (idempotent — || true absorbs "already exists")
            claude plugin marketplace add https://github.com/anthropics/claude-plugins-official >/dev/null 2>&1 || true
            if claude plugin install playground@claude-plugins-official >/dev/null 2>&1; then
                echo -e "  ${GREEN}✓${NC} Installed playground plugin"
            else
                echo -e "  ${YELLOW}⚠${NC} Playground plugin not installed (install manually: claude plugin install playground@claude-plugins-official)"
            fi
        fi
    fi

    # Create .buildcrew directory for project-specific overrides
    mkdir -p .buildcrew/rules

    # Create workflow.md.example if not present
    if [ ! -f ".buildcrew/workflow.md.example" ]; then
        cat > .buildcrew/workflow.md.example << 'EOF'
# Custom Workflow (Example)

Copy this file to workflow.md to customize your project's workflow.
Delete phases you don't need, or add new ones.

---

## Default Phase Structure (as of v1.11.0)

The default workflow runs these phases in order:

### SPEC (optional)
agent: product-manager
description: Convert raw backlog item into structured spec with testable acceptance criteria
output: .claude/spec.md
skip with: buildcrew run --skip-spec

### RESEARCH + PLAN
agent: none
description: Gather context, create implementation plan
output: .claude/research.md, .claude/current-plan.md

### PLAN-REVIEW (adversarial, 3-pass)
agents: principal-engineer, product-manager
description: Adversarial 3-pass review — find the most serious flaw
output: .claude/plan-review.md
gate: overall verdict == "APPROVED"

### BUILD
agent: feature-engineer
description: Implement the plan
output: working code

### SIMPLIFY (non-blocking)
agent: none
description: Review and apply targeted simplifications before formal code review
output: .claude/simplify-report.md

### CODE-REVIEW + REFACTOR + TEST
agents: principal-engineer, qa-engineer
description: Adversarial code review + elegance check + test suite
output: .claude/code-review.md, .claude/test-report.md

### OUTCOME
agent: qa-engineer
description: Validate each acceptance criterion from the spec against the actual implementation
output: .claude/outcome-report.md
note: Only runs if .claude/spec.md exists (i.e., spec phase was not skipped)
strict mode: buildcrew run --strict (blocks commit if any criteria fail)

### VERIFY + COMMIT
agents: security-engineer, none
description: Security audit + final gate + git commit
output: .claude/security-audit.md, .claude/verify-report.md
gate: all checks pass

---

## Minimal Custom Workflow Example

Paste this into .buildcrew/workflow.md to override the default:

```markdown
## Phases

### PLAN
agent: none
description: Create implementation plan

### BUILD
agent: feature-engineer
description: Implement the feature

### TEST
agent: qa-engineer
description: Write and run tests

### COMMIT
agent: none
description: Create git commit
```

---

## Available Agents

- principal-engineer: Architecture & adversarial code review
- feature-engineer: Pragmatic implementation
- security-engineer: Security audits
- qa-engineer: Testing and outcome verification
- product-manager: Discovery, spec writing, plan review
- ux-designer: Design specs

---

## Customization Tips

1. Use --skip-spec for tasks that already have detailed specs
2. Use --strict to enforce all acceptance criteria before commit
3. Remove PLAN_REVIEW and CODE_REVIEW for faster iteration on simple tasks
4. Add a DEPLOY phase after COMMIT for CI/CD integration
5. Run `buildcrew lessons` to review what BuildCrew has learned from past failures

See ~/.buildcrew/workflows/default-workflow.md for the full default workflow.
EOF
        echo -e "  ${GREEN}✓${NC} Created .buildcrew/workflow.md.example"
    else
        echo -e "  ${YELLOW}○${NC} Workflow example exists"
    fi

    # Create config.example if not present
    if [ ! -f ".buildcrew/config.example" ]; then
        cat > .buildcrew/config.example << 'EOF'
# BuildCrew Project Configuration
# Copy to .buildcrew/config to activate

# Maximum Claude invocations per buildcrew run (default: 15)
# MAX_INVOCATIONS=15

# Auto-detect task complexity and skip unnecessary phases (default: true)
# Set to false to always run all phases (equivalent to --full-pipeline)
# COMPLEXITY_AWARE=true

# Auto mode is enabled by default. Set to false to restore interactive review pauses.
# AUTO_MODE=true

EOF
        echo -e "  ${GREEN}✓${NC} Created .buildcrew/config.example"
    else
        echo -e "  ${YELLOW}○${NC} Config example exists"
    fi

    # Create project-rules.md.example if not present
    if [ ! -f ".buildcrew/rules/project-rules.md.example" ]; then
        cat > .buildcrew/rules/project-rules.md.example << 'EOF'
# Project-Specific Rules (Example)

Copy this file to project-rules.md to add custom rules for your project.
These rules extend the core BuildCrew principles.

---

## Override: Functions
<!-- Use ## Override: to replace a default rule -->
- Keep functions under 30 lines (default is 20)

## Extend: Custom Rules
<!-- Use ## Extend: to add to existing rules -->

### Linting & Formatting
- Run `npm run lint` before committing
- All TypeScript files must pass strict mode
- Use Prettier with project config

### Naming Conventions
- React components: PascalCase (UserProfile.tsx)
- Utilities: camelCase (formatDate.ts)
- Constants: SCREAMING_SNAKE_CASE
- Database tables: snake_case

### API Design
- All endpoints must return { data, error, meta }
- Use plural nouns for resource collections
- Version all public APIs: /v1/users

### Operational Rules
- API calls must use exponential backoff
- Batch updates to prevent thundering herd
- Rate limit external API calls to 10/sec

### Database
- All queries must use parameterized statements
- No N+1 query patterns
- Index foreign keys
- Use transactions for multi-step operations

### Frontend
- Components must be under 200 lines
- State management through designated store only
- All interactive elements must be keyboard accessible

## Disable: YAGNI
<!-- Use ## Disable: to remove a rule section entirely -->
<!-- Uncomment to disable YAGNI enforcement -->
EOF
        echo -e "  ${GREEN}✓${NC} Created .buildcrew/rules/project-rules.md.example"
    else
        echo -e "  ${YELLOW}○${NC} Rules example exists"
    fi

    # Create context directory and example files
    local _ctx_files="users.md principles.md domain.md conventions.md"
    # Snapshot pre-init state: on re-init, deleted .example files show "missing"
    local _ctx_dir_existed=0
    [ -d ".buildcrew/context" ] && _ctx_dir_existed=1
    local _ctx_pre_init_examples=""
    if [ "$_ctx_dir_existed" -eq 1 ]; then
        for _ctx_name in $_ctx_files; do
            if [ -f ".buildcrew/context/${_ctx_name}.example" ]; then
                _ctx_pre_init_examples="${_ctx_pre_init_examples} ${_ctx_name}"
            fi
        done
    fi
    mkdir -p .buildcrew/context

    if [ ! -f ".buildcrew/context/users.md.example" ]; then
        cat > .buildcrew/context/users.md.example << 'EOF'
# User Context

Copy this file to `users.md` to provide user context to BuildCrew.
This helps the Product Manager and plan reviewers understand who you're building for.

---

## Primary User

- **Who**: [e.g., Frontend developers on small teams]
- **Needs**: [e.g., Ship features fast without sacrificing quality]
- **Workflow**: [e.g., Uses VS Code, runs CI locally, deploys via GitHub Actions]
- **Success looks like**: [e.g., Feature works on first deploy, no rollbacks]

## Secondary User

- **Who**: [e.g., Team leads reviewing PRs]
- **Needs**: [e.g., Understand changes quickly, trust the test suite]
- **Workflow**: [e.g., Reviews PRs on GitHub, checks CI status]
- **Success looks like**: [e.g., PR description is clear, tests cover edge cases]

## Non-Users / Out of Scope

- [e.g., End users of the product — they interact through the UI, not the codebase]
EOF
        echo -e "  ${GREEN}✓${NC} Created .buildcrew/context/users.md.example"
    else
        echo -e "  ${YELLOW}○${NC} Users context example exists"
    fi

    if [ ! -f ".buildcrew/context/principles.md.example" ]; then
        cat > .buildcrew/context/principles.md.example << 'EOF'
# Project Principles

Copy this file to `principles.md` to guide BuildCrew's decisions.
When tradeoffs arise, these principles determine which direction to take.

---

## Principles

- **Ship over polish**: Working software in users' hands beats perfect code in a branch. Cut scope before delaying delivery.
- **Simplicity over power**: Choose the boring solution. A simple approach that works is better than a clever one that might.
- **Explicit over implicit**: Name things clearly, avoid magic, make dependencies obvious. Future-you is a stranger.
- **Fix the root cause**: Don't patch symptoms. If something keeps breaking, redesign it.
EOF
        echo -e "  ${GREEN}✓${NC} Created .buildcrew/context/principles.md.example"
    else
        echo -e "  ${YELLOW}○${NC} Principles context example exists"
    fi

    if [ ! -f ".buildcrew/context/domain.md.example" ]; then
        cat > .buildcrew/context/domain.md.example << 'EOF'
# Domain Knowledge

Copy this file to `domain.md` to give BuildCrew context about your problem domain.
This helps personas make informed decisions without asking repetitive questions.

---

## Terminology

| Term | Definition |
|------|-----------|
| [Term] | [What it means in your project] |

## Business Rules

- [e.g., Users must verify email before accessing paid features]
- [e.g., All prices are stored in cents to avoid floating-point issues]

## Key Constraints

- [e.g., Must support IE11 for enterprise clients]
- [e.g., API responses must be < 200ms at p95]
- [e.g., HIPAA compliance required — no PII in logs]
EOF
        echo -e "  ${GREEN}✓${NC} Created .buildcrew/context/domain.md.example"
    else
        echo -e "  ${YELLOW}○${NC} Domain context example exists"
    fi

    if [ ! -f ".buildcrew/context/conventions.md.example" ]; then
        cat > .buildcrew/context/conventions.md.example << 'EOF'
# Conventions

Copy this file to `conventions.md` to tell BuildCrew about your coding conventions.
This helps personas follow your team's established patterns and style.

---

## Coding Style

- [e.g., Use functional style — prefer pure functions and immutable data]
- [e.g., Max function length: 20 lines]

## Naming Patterns

- [e.g., React components: PascalCase (UserProfile.tsx)]
- [e.g., Utilities: camelCase (formatDate.ts)]
- [e.g., Constants: SCREAMING_SNAKE_CASE]

## Formatting Rules

- [e.g., Use Prettier with project config]
- [e.g., 2-space indentation, no tabs]
- [e.g., Max line length: 100 characters]

## Tooling Preferences

- [e.g., Package manager: pnpm]
- [e.g., Linter: ESLint with strict config]
- [e.g., Test framework: Vitest]
EOF
        echo -e "  ${GREEN}✓${NC} Created .buildcrew/context/conventions.md.example"
    else
        echo -e "  ${YELLOW}○${NC} Conventions context example exists"
    fi

    # Create BACKLOG.md template if not present
    if [ ! -f "BACKLOG.md" ]; then
        cat > BACKLOG.md << 'EOF'
# Backlog

*Add your tasks here, then run `buildcrew run` to process them.*

## High Priority

- [ ] Your first task here

## Medium Priority

- [ ] Another task

## Low Priority

- [ ] Future task

---
*Use `/build` in Claude Code to generate a comprehensive backlog from your project plan.*
EOF
        echo -e "  ${GREEN}✓${NC} Created BACKLOG.md template"
    else
        echo -e "  ${YELLOW}○${NC} BACKLOG.md exists"
    fi

    # Create or update .claude/settings.json with comprehensive autonomous permissions
    if [ ! -f ".claude/settings.json" ]; then
        cat > .claude/settings.json << 'EOF'
{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "Task",

      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(bun:*)",
      "Bash(node:*)",
      "Bash(deno:*)",

      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(poetry:*)",
      "Bash(uv:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(black:*)",
      "Bash(mypy:*)",
      "Bash(flake8:*)",

      "Bash(go:*)",
