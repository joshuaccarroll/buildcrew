      "Bash(rm -rf ~:*)",
      "Bash(rm -rf /*:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(rm -rf /etc:*)",
      "Bash(rm -rf /usr:*)",
      "Bash(rm -rf /var:*)",
      "Bash(rm -rf /bin:*)",
      "Bash(rm -rf /sbin:*)",
      "Bash(rm -rf /lib:*)",
      "Bash(rm -rf /boot:*)",
      "Bash(rm -rf /root:*)",
      "Bash(rm -rf /System:*)",
      "Bash(rm -rf /Applications:*)",
      "Bash(rm -rf /Library:*)",

      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Bash(git reset --hard HEAD~:*)",
      "Bash(git reset --hard origin:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git clean -fd:*)",

      "Bash(mkfs:*)",
      "Bash(dd if=/dev/zero:*)",
      "Bash(dd of=/dev:*)",
      "Bash(> /dev/sda:*)",
      "Bash(chmod -R 777 /:*)",
      "Bash(chown -R:*)",

      "Bash(curl | sh:*)",
      "Bash(curl | bash:*)",
      "Bash(wget | sh:*)",
      "Bash(wget | bash:*)",

      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(halt:*)",
      "Bash(poweroff:*)",
      "Bash(init:*)",
      "Bash(systemctl:*)",
      "Bash(service:*)",
      "Bash(launchctl:*)",

      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",

      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.ssh/*)",
      "Read(**/credentials*)",
      "Read(**/secrets*)",
      "Read(**/.aws/*)",
      "Read(**/.gcloud/*)",
      "Read(**/.azure/*)"
    ]
  }
}
EOF
        local tmp_settings
        tmp_settings=$(jq --arg cmd "$BUILDCREW_HOME/lib/statusline.sh" \
            '. + {statusLine: {type: "command", command: $cmd}}' .claude/settings.json)
        printf '%s\n' "$tmp_settings" > .claude/settings.json
        echo -e "  ${GREEN}✓${NC} Created .claude/settings.json with autonomous permissions"
        echo -e "  ${YELLOW}⚠${NC}  Review .claude/settings.json - these permissions enable autonomous operation"
    else
        if ! jq -e '.statusLine' .claude/settings.json >/dev/null 2>&1; then
            local tmp_settings
            tmp_settings=$(jq --arg cmd "$BUILDCREW_HOME/lib/statusline.sh" \
                '. + {statusLine: {type: "command", command: $cmd}}' .claude/settings.json)
            printf '%s\n' "$tmp_settings" > .claude/settings.json
            echo -e "  ${GREEN}+${NC} Added statusLine to .claude/settings.json"
        else
            echo -e "  ${YELLOW}○${NC} .claude/settings.json exists (statusLine already configured)"
        fi
    fi

    # Interactive context prompts (TTY only, not --quick)
    if [[ -t 0 ]] && [[ $quick -eq 0 ]]; then
        _read_context_topic() {
            local topic="$1" prompt_text="$2"
            if [ -f ".buildcrew/context/${topic}.md" ]; then
                echo -e "  ${YELLOW}○${NC} ${topic}.md exists — skipping"
                return
            fi
            echo -e "  ${prompt_text}"
            echo -e "  ${DIM}(enter text line by line; blank line to finish, or just Enter to skip)${NC}"
            local content="" line line_count=0
            while IFS= read -r line; do
                [ -z "$line" ] && break
                content+="${content:+$'\n'}$line"
                ((line_count++))
            done
            if [[ "$content" =~ [^[:space:]] ]]; then
                printf '%s' "$content" > ".buildcrew/context/${topic}.md"
                echo -e "  ${GREEN}✓${NC} Created ${topic}.md (${line_count} lines)"
            fi
        }

        echo ""
        echo -e "${BOLD}Project context:${NC}"
        _read_context_topic "users" "Who are the primary users of this project?"
        _read_context_topic "domain" "What are the key domain terms and business rules?"
        _read_context_topic "principles" "What core principles guide this project?"
        _read_context_topic "conventions" "What coding conventions does this project follow?"
    fi

    echo ""
    echo -e "${GREEN}${BOLD}BuildCrew initialized!${NC}"
    echo ""
    echo -e "${BOLD}What was created:${NC}"
    echo -e "  • ${CYAN}.claude/commands${NC} - BuildCrew slash commands (/build, /buildcrew)"
    echo -e "  • ${CYAN}.claude/skills${NC} - BuildCrew skills (builder, personas)"
    echo -e "  • ${CYAN}.claude/settings.json${NC} - Permissions for Claude Code"
    echo -e "  • ${CYAN}.buildcrew/${NC} - Directory for project-specific customization"
    echo -e "  • ${CYAN}BACKLOG.md${NC} - Your task backlog"
    echo ""
    echo -e "${BOLD}Optional customization:${NC}"
    echo -e "  • Copy ${CYAN}.buildcrew/workflow.md.example${NC} to ${CYAN}workflow.md${NC} to customize phases"
    echo -e "  • Copy ${CYAN}.buildcrew/rules/project-rules.md.example${NC} to add project rules"
    echo ""
    echo "Context files:"
    for _ctx_name in $_ctx_files; do
        if [ -f ".buildcrew/context/${_ctx_name}" ]; then
            local _ctx_bytes
            _ctx_bytes=$(wc -c < ".buildcrew/context/${_ctx_name}" | tr -d ' ')
            echo "  ✓ ${_ctx_name} (${_ctx_bytes} bytes)"
        elif [ -n "$_ctx_pre_init_examples" ] && [[ " $_ctx_pre_init_examples " != *" ${_ctx_name} "* ]]; then
            echo "  ✗ ${_ctx_name} missing"
        elif [ -f ".buildcrew/context/${_ctx_name}.example" ]; then
            echo "  ✗ ${_ctx_name} cp .buildcrew/context/${_ctx_name}.example .buildcrew/context/${_ctx_name}"
        else
            echo "  ✗ ${_ctx_name} missing"
        fi
    done
    echo ""
    echo -e "${BOLD}Next steps:${NC}"
    echo -e "  1. Run ${CYAN}buildcrew run${NC} to start"
    echo -e "  2. Use ${CYAN}/buildcrew <persona>${NC} to invoke a persona ad-hoc"
    echo ""
}

refresh_project_symlinks() {
    if [ ! -f ".claude/.buildcrew-link" ]; then
        echo "  Tip: Run 'buildcrew init' in your project to link new skills."
        return
    fi

    echo "Refreshing project symlinks..."

    # Refresh commands symlink
    if [ -L ".claude/commands" ]; then
        rm -f ".claude/commands"
    fi
    if [ ! -e ".claude/commands" ]; then
        ln -s "$BUILDCREW_HOME/commands" ".claude/commands"
        echo -e "  ${GREEN}✓${NC} Linked commands"
    else
        echo -e "  ${YELLOW}○${NC} .claude/commands is a local directory (not a symlink) — skipped"
    fi

    # Refresh skills symlink
    if [ -L ".claude/skills" ]; then
        rm -f ".claude/skills"
    fi
    if [ ! -e ".claude/skills" ]; then
        ln -s "$BUILDCREW_HOME/skills" ".claude/skills"
        echo -e "  ${GREEN}✓${NC} Linked skills"
    else
        # Real directory — link individual skill subdirectories
        _ensure_skill_symlinks
    fi

    # Update buildcrew-link marker
    echo "BUILDCREW_HOME=$BUILDCREW_HOME" > .claude/.buildcrew-link
    echo -e "  ${GREEN}✓${NC} Project symlinks refreshed"
}

cmd_plugins() {
    print_logo
    echo -e "${BOLD}Plugin Recommendations${NC}"
    echo ""
    check_plugins
}

cmd_lessons() {
    local subcommand="${1:-}"
    local lessons_file=".buildcrew/lessons.md"

    if [[ ! -f "$lessons_file" ]]; then
        if [[ -z "$subcommand" ]]; then
            echo -e "${CYAN}No lessons recorded yet.${NC}"
            echo "Lessons are automatically written when BuildCrew encounters and resolves failures."
            return
        fi
    fi

    case "$subcommand" in
        "")
            # List all lessons
            echo -e "${BOLD}BuildCrew Lessons${NC}"
            echo ""
            if [[ ! -f "$lessons_file" ]]; then
                echo -e "${CYAN}No lessons recorded yet.${NC}"
                return
            fi

            # Check once for condensed patterns section — used by both display block and total line
            local has_patterns=false
            if grep -q '^## Patterns' "$lessons_file" 2>/dev/null; then
                has_patterns=true
            fi

            # Display condensed patterns section if present
            if [[ "$has_patterns" == "true" ]]; then
                echo -e "  ${BOLD}Condensed Patterns${NC} (older lessons summarized)"
                echo ""
                # Print bullet rules from the Patterns section
                awk '/^## Patterns/,/^## Lesson [0-9]/{
                    if (/^- /) print "  " $0
                }' "$lessons_file"
                echo ""
                echo -e "  --- Active Lessons ---"
                echo ""
            fi

            # Extract and display lesson headers with their phase and rule
            local lesson_count=0
            local in_lesson=false
            local current_num=""
            local current_phase=""
            local current_rule=""
            while IFS= read -r line; do
                if [[ "$line" =~ ^##\ Lesson\ ([0-9]+): ]]; then
                    in_lesson=true
                    current_num="${BASH_REMATCH[1]}"
                    current_phase=""
                    current_rule=""
                    ((lesson_count++))
                elif [[ "$in_lesson" == "true" ]]; then
                    if [[ "$line" =~ ^\*\*Phase\*\*:\ (.+) ]]; then
                        current_phase="${BASH_REMATCH[1]}"
                    elif [[ "$line" =~ ^\*\*Rule\*\*:\ (.+) ]]; then
                        current_rule="${BASH_REMATCH[1]}"
                    elif [[ "$line" == "---" ]]; then
                        echo -e "  ${BOLD}[$current_num]${NC} [${CYAN}${current_phase}${NC}] $current_rule"
                        in_lesson=false
                    fi
                fi
            done < "$lessons_file"
            echo ""
            if [[ "$has_patterns" == "true" ]]; then
                echo -e "  Total: ${lesson_count} lesson(s) (plus older entries condensed into Patterns section above)"
            else
                echo -e "  Total: ${lesson_count} lesson(s)"
            fi
            echo ""
            echo -e "  ${BOLD}buildcrew lessons promote N${NC}   Graduate lesson N to project rules"
            echo -e "  ${BOLD}buildcrew lessons prune${NC}        Interactively remove stale lessons"
            echo -e "  ${BOLD}buildcrew lessons lint${NC}         Check lessons for vague or weak rules"
            ;;

        promote)
            local lesson_num="${2:-}"
            if [[ -z "$lesson_num" ]] || ! [[ "$lesson_num" =~ ^[0-9]+$ ]]; then
                echo -e "${RED}Error:${NC} Please provide a lesson number to promote."
                echo "Usage: buildcrew lessons promote <number>"
                exit 1
            fi
            if [[ ! -f "$lessons_file" ]]; then
                echo -e "${RED}Error:${NC} No lessons file found."
                exit 1
            fi

            # Extract the lesson
            local lesson_rule=""
            local lesson_phase=""
            local in_target=false
            while IFS= read -r line; do
                if [[ "$line" =~ ^##\ Lesson\ ${lesson_num}: ]]; then
                    in_target=true
                elif [[ "$in_target" == "true" ]]; then
                    if [[ "$line" =~ ^\*\*Phase\*\*:\ (.+) ]]; then
                        lesson_phase="${BASH_REMATCH[1]}"
                    elif [[ "$line" =~ ^\*\*Rule\*\*:\ (.+) ]]; then
                        lesson_rule="${BASH_REMATCH[1]}"
                    elif [[ "$line" == "---" ]]; then
                        break
                    fi
                fi
            done < "$lessons_file"

            if [[ -z "$lesson_rule" ]]; then
                echo -e "${RED}Error:${NC} Lesson $lesson_num not found."
                exit 1
            fi

            # Append to project-rules.md
            local rules_file=".buildcrew/rules/project-rules.md"
            mkdir -p .buildcrew/rules
            if [[ ! -f "$rules_file" ]]; then
                cat > "$rules_file" << 'RULES_HEADER'
# Project Rules

Rules promoted from BuildCrew lessons. These become permanent team standards.

---

RULES_HEADER
            fi

            cat >> "$rules_file" << EOF

## Lesson-Promoted Rule (from Lesson ${lesson_num} — ${lesson_phase})
- ${lesson_rule}
EOF
            echo -e "${GREEN}✓${NC} Lesson $lesson_num promoted to $rules_file"
            echo "  Rule: $lesson_rule"
            ;;

        prune)
            if [[ ! -f "$lessons_file" ]]; then
                echo -e "${CYAN}No lessons to prune.${NC}"
                return
            fi
            if [[ ! -t 0 ]]; then
                echo -e "${YELLOW}⚠${NC} Non-interactive terminal — cannot prune interactively."
                exit 1
            fi

            echo -e "${BOLD}Pruning Lessons${NC} (press Enter to keep, 'd' to delete)"
            echo ""

            local tmp_file
            tmp_file=$(mktemp)
            local in_lesson=false
            local current_block=""
            local current_num=""
            local kept=0
            local pruned=0

            # Copy the header (before first lesson)
            awk '/^## Lesson [0-9]/{exit} {print}' "$lessons_file" > "$tmp_file"

            # Process each lesson block
            while IFS= read -r line; do
                if [[ "$line" =~ ^##\ Lesson\ ([0-9]+): ]]; then
                    current_num="${BASH_REMATCH[1]}"
                    current_block="$line"$'\n'
                    in_lesson=true
                elif [[ "$in_lesson" == "true" ]]; then
                    current_block+="$line"$'\n'
                    if [[ "$line" == "---" ]]; then
                        # Show the lesson and ask
                        echo "$current_block"
                        echo -n "  Keep lesson $current_num? [Enter=keep, d=delete]: "
                        read -r prune_response
                        if [[ "$prune_response" == "d" || "$prune_response" == "D" ]]; then
                            echo -e "  ${YELLOW}Deleted${NC} lesson $current_num"
                            ((pruned++))
                        else
                            echo "$current_block" >> "$tmp_file"
                            ((kept++))
                        fi
                        in_lesson=false
                        current_block=""
                        echo ""
                    fi
                fi
            done < "$lessons_file"

            mv "$tmp_file" "$lessons_file"
            echo -e "${GREEN}✓${NC} Pruning complete: kept $kept, removed $pruned lesson(s)"
            ;;

        lint)
            if [[ ! -f "$lessons_file" ]]; then
                echo -e "${CYAN}No lessons to lint.${NC}"
                return
            fi

            # Blocklist of vague first words that indicate a weak rule
            local blocklist="always|never|ensure|remember|make sure|avoid|try|don't forget|be careful"
            local issues=0
            local lesson_num=""

            while IFS= read -r line; do
                if [[ "$line" =~ ^##\ Lesson\ ([0-9]+): ]]; then
                    lesson_num="${BASH_REMATCH[1]}"
                elif [[ "$line" =~ ^\*\*Rule\*\*:\ (.+) ]]; then
                    local rule="${BASH_REMATCH[1]}"
                    local first_word
                    first_word=$(echo "$rule" | awk '{print tolower($1)}')
                    if echo "$first_word" | grep -qiE "^($blocklist)$"; then
                        echo -e "  ${YELLOW}⚠${NC} Lesson $lesson_num: rule starts with vague word '${first_word}'"
                        echo "    Rule: $rule"
                        ((issues++))
                    fi
                fi
            done < "$lessons_file"

            if [[ $issues -eq 0 ]]; then
                echo -e "${GREEN}✓${NC} All lesson rules look actionable."
            else
                echo ""
                echo -e "  ${BOLD}$issues${NC} lesson(s) with vague rules. Consider rephrasing to be specific and actionable."
            fi
            ;;

        *)
            echo -e "${RED}Error:${NC} Unknown lessons subcommand '$subcommand'"
            echo "Usage: buildcrew lessons [promote <N> | prune | lint]"
            exit 1
            ;;
    esac
}

cmd_stop() {
    mkdir -p .buildcrew
    touch .buildcrew/.stop-workflow
    echo -e "${GREEN}✓${NC} Stop signal sent. Workflow will stop after the current task completes."
}

cmd_reset() {
    source "$BUILDCREW_HOME/lib/common.sh"

    # Require BACKLOG.md
    if [[ ! -f "$BACKLOG_FILE" ]]; then
        echo -e "${RED}Error:${NC} No BACKLOG.md found in current directory."
        exit 1
    fi

    echo -e "${BOLD}BuildCrew Reset${NC}"
    echo ""

    local blocked_count
    blocked_count=$(count_tasks blocked)

    # 1. Reset blocked tasks → pending (strip blocked marker and reason)
    if [[ "$blocked_count" -gt 0 ]]; then
        # [!] Task name (blocked: reason) → [ ] Task name
        perl -i -pe 's/^- \[!\] (.+?) \(blocked:.*?\)$/- [ ] $1/' "$BACKLOG_FILE"
        # Catch any [!] lines without a reason suffix
        perl -i -pe 's/^- \[!\] /- [ ] /' "$BACKLOG_FILE"
        echo -e "  ${GREEN}✓${NC} Reset $blocked_count blocked task(s) to pending"
    else
        echo -e "  ${CYAN}○${NC} No blocked tasks to reset"
    fi

    # 2. Clean .claude/ artifacts
    local artifact_files=(
        .claude/research.md .claude/current-plan.md .claude/plan-review.md
        .claude/code-review.md .claude/test-report.md .claude/security-audit.md
        .claude/verify-report.md .claude/current-test-plan.md
        .claude/phase-result.json .claude/workflow-status.json
    )
    local cleaned=0
    for f in "${artifact_files[@]}"; do
        if [[ -f "$f" ]]; then
            rm -f "$f"
            ((cleaned++))
        fi
    done
    if [[ "$cleaned" -gt 0 ]]; then
        echo -e "  ${GREEN}✓${NC} Removed $cleaned artifact file(s)"
    else
        echo -e "  ${CYAN}○${NC} No artifacts to clean"
    fi

    # 3. Remove stale lockfile and state files
    local state_cleaned=0
    for f in .buildcrew/.workflow-lock .buildcrew/task-progress.json .buildcrew/.current-task .buildcrew/.stop-workflow; do
        if [[ -f "$f" ]]; then
            rm -f "$f"
            ((state_cleaned++))
        fi
    done
    if [[ "$state_cleaned" -gt 0 ]]; then
        echo -e "  ${GREEN}✓${NC} Removed $state_cleaned state file(s)"
    else
        echo -e "  ${CYAN}○${NC} No stale state files"
    fi

    echo ""
    echo -e "${GREEN}${BOLD}Reset complete.${NC}"
    echo ""
    echo -e "  Pending: $(count_tasks pending) | Completed: $(count_tasks completed) | Blocked: $(count_tasks blocked)"
    echo ""
}

# _repair_check_skills <fix_mode> <interactive> <stored_home>
# Inspects .claude/skills/ — either as a symlink or as a real directory containing per-skill entries.
# Reads and mutates __REPAIR_ISSUES, __REPAIR_REMAINING, __REPAIR_SKIPPED_PROMPTED globals.
_repair_check_skills() {
    local fix_mode="$1"
    local interactive="$2"
    local stored_home="$3"

    local skills_dir=".claude/skills"

    # Determine the state of .claude/skills itself
    if [ ! -L "$skills_dir" ] && [ ! -e "$skills_dir" ]; then
        # Missing — safe auto-fix
        __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
        echo -e "  ${YELLOW}⚠${NC} .claude/skills — missing"
        if [[ "$fix_mode" == "true" ]]; then
            ln -s "$stored_home/skills" "$skills_dir" || true
            if [ -L "$skills_dir" ]; then
                echo -e "    → Created symlink to $stored_home/skills"
            else
                echo -e "    ${RED}✗${NC} Failed to create symlink — check permissions"
                __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
            fi
        else
            __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
        fi
        return
    fi

    if [ -L "$skills_dir" ]; then
        local link_target
        link_target="$(readlink "$skills_dir")"
        if [ ! -e "$skills_dir" ]; then
            # Broken symlink
            __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
            echo -e "  ${YELLOW}⚠${NC} .claude/skills — broken symlink → $link_target"
            if [[ "$fix_mode" == "true" ]]; then
                if [[ "$interactive" == "true" ]]; then
                    printf "    Replace with symlink to %s? [y/N] " "$stored_home/skills"
                    read -r answer
                    if [[ "$answer" == "y" || "$answer" == "Y" ]]; then
                        rm -f "$skills_dir"
                        ln -s "$stored_home/skills" "$skills_dir" || true
                        if [ -L "$skills_dir" ]; then
                            echo -e "    ${GREEN}✓${NC} Fixed"
                        else
                            echo -e "    ${RED}✗${NC} Failed to create symlink — check permissions"
                            __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                        fi
                    else
                        __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                    fi
                else
                    __REPAIR_SKIPPED_PROMPTED=$((__REPAIR_SKIPPED_PROMPTED + 1))
                    __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                    echo -e "    → Skipped (non-interactive — run \`buildcrew repair --fix\` in a terminal)"
                fi
            else
                __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
            fi
        else
            # Symlink exists and resolves — check target
            local expected="${stored_home}/skills"
            local norm_link="${link_target%/}"
            local norm_expected="${expected%/}"
            if [[ "$norm_link" != "$norm_expected" ]]; then
                __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
                echo -e "  ${YELLOW}⚠${NC} .claude/skills — symlink to wrong target"
                echo -e "    Current:  $link_target"
                echo -e "    Proposed: $expected"
                if [[ "$fix_mode" == "true" ]]; then
                    if [[ "$interactive" == "true" ]]; then
                        printf "    Repoint symlink? [y/N] "
                        read -r answer
                        if [[ "$answer" == "y" || "$answer" == "Y" ]]; then
                            rm -f "$skills_dir"
                            ln -s "$expected" "$skills_dir" || true
                            if [ -L "$skills_dir" ]; then
                                echo -e "    ${GREEN}✓${NC} Fixed"
                            else
                                echo -e "    ${RED}✗${NC} Failed to create symlink — check permissions"
                                __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                            fi
                        else
                            __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                        fi
                    else
                        __REPAIR_SKIPPED_PROMPTED=$((__REPAIR_SKIPPED_PROMPTED + 1))
                        __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                        echo -e "    → Skipped (non-interactive — run \`buildcrew repair --fix\` in a terminal)"
                    fi
                else
                    __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                fi
            else
                echo -e "  ${GREEN}✓${NC} .claude/skills — symlink OK"
            fi
        fi
        return
    fi

    # .claude/skills is a real directory — inspect per-skill entries
    # Guard: verify the source skills directory exists
    if [ ! -d "$BUILDCREW_HOME/skills" ]; then
        echo -e "  ${YELLOW}⚠${NC} $BUILDCREW_HOME/skills — directory missing (broken installation)"
        __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
        __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
        return
    fi

    local had_skill_issues=false
    local skill_path skill_name dest link_target expected norm_link norm_expected

    for skill_path in "$BUILDCREW_HOME/skills"/*/; do
        [ -d "$skill_path" ] || continue
        skill_name="$(basename "$skill_path")"
        dest="$skills_dir/$skill_name"
        expected="$BUILDCREW_HOME/skills/$skill_name"

        if [ ! -L "$dest" ] && [ ! -e "$dest" ]; then
            # Missing — safe auto-fix
            __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
            had_skill_issues=true
            echo -e "  ${YELLOW}⚠${NC} .claude/skills/$skill_name — missing"
            if [[ "$fix_mode" == "true" ]]; then
                ln -s "$expected" "$dest" || true
                if [ -L "$dest" ]; then
                    echo -e "    → Created symlink to $expected"
                else
                    echo -e "    ${RED}✗${NC} Failed to create symlink — check permissions"
                    __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                fi
            else
                __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
            fi
        elif [ -L "$dest" ]; then
            link_target="$(readlink "$dest")"
            if [ ! -e "$dest" ]; then
                # Broken symlink
                __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
                had_skill_issues=true
                echo -e "  ${YELLOW}⚠${NC} .claude/skills/$skill_name — broken symlink → $link_target"
                if [[ "$fix_mode" == "true" ]]; then
                    if [[ "$interactive" == "true" ]]; then
                        printf "    Replace with symlink to %s? [y/N] " "$expected"
                        read -r answer
                        if [[ "$answer" == "y" || "$answer" == "Y" ]]; then
                            rm -f "$dest"
                            ln -s "$expected" "$dest" || true
                            if [ -L "$dest" ]; then
                                echo -e "    ${GREEN}✓${NC} Fixed"
                            else
                                echo -e "    ${RED}✗${NC} Failed to create symlink — check permissions"
                                __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                            fi
                        else
                            __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                        fi
                    else
                        __REPAIR_SKIPPED_PROMPTED=$((__REPAIR_SKIPPED_PROMPTED + 1))
                        __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                        echo -e "    → Skipped (non-interactive — run \`buildcrew repair --fix\` in a terminal)"
                    fi
                else
                    __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                fi
            else
                # Symlink exists and resolves
                norm_link="${link_target%/}"
                norm_expected="${expected%/}"
                if [[ "$norm_link" != "$norm_expected" ]]; then
                    __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
                    had_skill_issues=true
                    echo -e "  ${YELLOW}⚠${NC} .claude/skills/$skill_name — symlink to wrong target"
                    echo -e "    Current:  $link_target"
                    echo -e "    Proposed: $expected"
                    if [[ "$fix_mode" == "true" ]]; then
                        if [[ "$interactive" == "true" ]]; then
                            printf "    Repoint symlink? [y/N] "
                            read -r answer
                            if [[ "$answer" == "y" || "$answer" == "Y" ]]; then
                                rm -f "$dest"
                                ln -s "$expected" "$dest" || true
                                if [ -L "$dest" ]; then
                                    echo -e "    ${GREEN}✓${NC} Fixed"
                                else
                                    echo -e "    ${RED}✗${NC} Failed to create symlink — check permissions"
                                    __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                                fi
                            else
                                __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                            fi
                        else
                            __REPAIR_SKIPPED_PROMPTED=$((__REPAIR_SKIPPED_PROMPTED + 1))
                            __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                            echo -e "    → Skipped (non-interactive — run \`buildcrew repair --fix\` in a terminal)"
                        fi
                    else
                        __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                    fi
                fi
            fi
        else
            # Real directory — manual review required
            __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
            __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
            had_skill_issues=true
            echo -e "  ${YELLOW}⚠${NC} .claude/skills/$skill_name — real directory (not a symlink)"
            echo -e "    → Manual review required. Skipping."
        fi
    done

    if [[ "$had_skill_issues" == "false" ]]; then
        echo -e "  ${GREEN}✓${NC} .claude/skills — per-skill entries OK"
    fi
}

cmd_repair() {
    local fix_mode=false
    local arg
    for arg in "$@"; do
        case "$arg" in
            --fix) fix_mode=true ;;
            *) echo -e "${RED}Error:${NC} Unknown option '$arg'"; echo "Usage: buildcrew repair [--fix]"; exit 1 ;;
        esac
    done

    local interactive=false
    [[ -t 0 ]] && interactive=true

    # Global counters
    __REPAIR_ISSUES=0
    __REPAIR_REMAINING=0
    __REPAIR_SKIPPED_PROMPTED=0
    __repair_workflow_live=false
    __repair_workflow_pid=""

    if [[ "$fix_mode" == "true" ]]; then
        echo -e "${BOLD}BuildCrew Repair — Fix Mode${NC}"
    else
        echo -e "${BOLD}BuildCrew Repair — Health Check${NC}"
    fi
    echo ""

    # ─── C1: .claude/.buildcrew-link ─────────────────────────────────────────────
    local stored_home=""

    if [ ! -d ".claude" ]; then
        __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
        __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
        echo -e "  ${YELLOW}⚠${NC} BuildCrew is not initialized. Run \`buildcrew init\`."
        echo ""
        echo "1 issue(s) found."
        exit 1
    fi

    if [ ! -f ".claude/.buildcrew-link" ]; then
        __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
        __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
        echo -e "  ${YELLOW}⚠${NC} BuildCrew is not initialized in this project. Run \`buildcrew init\`."
        echo ""
        echo "1 issue(s) found."
        exit 1
    fi

    # Parse BUILDCREW_HOME= line without sourcing or eval
    local parsed_home=""
    while IFS= read -r line; do
        case "$line" in
            BUILDCREW_HOME=*)
                parsed_home="${line#BUILDCREW_HOME=}"
                break
                ;;
        esac
    done < ".claude/.buildcrew-link"

    if [ -z "$parsed_home" ]; then
        # Malformed — no BUILDCREW_HOME= line
        __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
        echo -e "  ${YELLOW}⚠${NC} .claude/.buildcrew-link is malformed — expected \`BUILDCREW_HOME=<path>\`"
        if [[ "$fix_mode" == "true" ]]; then
            if [[ "$interactive" == "true" ]]; then
                printf "    Rewrite with BUILDCREW_HOME=%s? [y/N] " "$BUILDCREW_HOME"
                read -r answer
                if [[ "$answer" == "y" || "$answer" == "Y" ]]; then
                    echo "BUILDCREW_HOME=$BUILDCREW_HOME" > ".claude/.buildcrew-link"
                    stored_home="$BUILDCREW_HOME"
                    echo -e "    ${GREEN}✓${NC} Fixed"
                else
                    stored_home="$BUILDCREW_HOME"
                    echo -e "    → Using runtime path ($BUILDCREW_HOME) for subsequent checks"
                    __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                fi
            else
                __REPAIR_SKIPPED_PROMPTED=$((__REPAIR_SKIPPED_PROMPTED + 1))
                __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                stored_home="$BUILDCREW_HOME"
                echo -e "    → Skipped (non-interactive — run \`buildcrew repair --fix\` in a terminal)"
                echo -e "    → Using runtime path ($BUILDCREW_HOME) for subsequent checks"
            fi
        else
            stored_home="$BUILDCREW_HOME"
            __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
            echo -e "    → Using runtime path ($BUILDCREW_HOME) for subsequent checks"
        fi
    elif [ ! -d "$parsed_home" ]; then
        # Stale — path doesn't exist on disk
        __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
        echo -e "  ${YELLOW}⚠${NC} .claude/.buildcrew-link — stale path ($parsed_home does not exist)"
        if [[ "$fix_mode" == "true" ]]; then
            if [[ "$interactive" == "true" ]]; then
                printf "    Rewrite with BUILDCREW_HOME=%s? [y/N] " "$BUILDCREW_HOME"
                read -r answer
                if [[ "$answer" == "y" || "$answer" == "Y" ]]; then
                    echo "BUILDCREW_HOME=$BUILDCREW_HOME" > ".claude/.buildcrew-link"
                    stored_home="$BUILDCREW_HOME"
                    echo -e "    ${GREEN}✓${NC} Fixed"
                else
                    stored_home="$BUILDCREW_HOME"
                    echo -e "    → Using runtime path ($BUILDCREW_HOME) for subsequent checks"
                    __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                fi
            else
                __REPAIR_SKIPPED_PROMPTED=$((__REPAIR_SKIPPED_PROMPTED + 1))
                __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                stored_home="$BUILDCREW_HOME"
                echo -e "    → Skipped (non-interactive — run \`buildcrew repair --fix\` in a terminal)"
                echo -e "    → Using runtime path ($BUILDCREW_HOME) for subsequent checks"
            fi
        else
            stored_home="$BUILDCREW_HOME"
            __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
            echo -e "    → Using runtime path ($BUILDCREW_HOME) for subsequent checks"
        fi
    else
        stored_home="$parsed_home"
        echo -e "  ${GREEN}✓${NC} .claude/.buildcrew-link — valid (BUILDCREW_HOME=$parsed_home)"
    fi

    # ─── C5: Lock/state files (must run before C4) ───────────────────────────────
    local lockfile=".buildcrew/.workflow-lock"
    if [ -f "$lockfile" ]; then
        local pid_val
        pid_val="$(cat "$lockfile" 2>/dev/null || true)"
        if [[ "$pid_val" =~ ^[0-9]+$ ]] && kill -0 "$pid_val" 2>/dev/null; then
            __repair_workflow_live=true
            __repair_workflow_pid="$pid_val"
            echo -e "  ${CYAN}○${NC} .buildcrew/.workflow-lock — workflow running (PID $pid_val)"
        else
            # Stale lock
            __repair_workflow_live=false
            __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
            echo -e "  ${YELLOW}⚠${NC} .buildcrew/.workflow-lock — stale lock (PID: ${pid_val:-none})"
            if [[ "$fix_mode" == "true" ]]; then
                rm -f "$lockfile" || true
                echo -e "    → Removed"
            else
                __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
            fi
        fi
    else
        __repair_workflow_live=false
        echo -e "  ${GREEN}✓${NC} .buildcrew/.workflow-lock — absent"
    fi

    local stop_file=".buildcrew/.stop-workflow"
    if [ -f "$stop_file" ]; then
        __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
        echo -e "  ${YELLOW}⚠${NC} .buildcrew/.stop-workflow — stop signal is set — \`buildcrew run\` will not start a new workflow"
        if [[ "$fix_mode" == "true" ]]; then
            if [[ "$interactive" == "true" ]]; then
                printf "    Remove stop signal? [y/N] "
                read -r answer
                if [[ "$answer" == "y" || "$answer" == "Y" ]]; then
                    rm -f "$stop_file" || true
                    echo -e "    ${GREEN}✓${NC} Fixed"
                else
                    __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                fi
            else
                __REPAIR_SKIPPED_PROMPTED=$((__REPAIR_SKIPPED_PROMPTED + 1))
                __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                echo -e "    → Skipped (non-interactive — run \`buildcrew repair --fix\` in a terminal)"
            fi
        else
            __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
        fi
    fi

    local progress_file=".buildcrew/task-progress.json"
    local current_task_file=".buildcrew/.current-task"
    if [[ "$__repair_workflow_live" == "false" ]]; then
        for state_f in "$progress_file" "$current_task_file"; do
            if [ -f "$state_f" ]; then
                __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
                echo -e "  ${YELLOW}⚠${NC} $state_f — stale state file"
                if [[ "$fix_mode" == "true" ]]; then
                    rm -f "$state_f" || true
                    echo -e "    → Removed"
                else
                    __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                fi
            fi
        done
    fi

    # ─── C4: Stale phase artifacts ────────────────────────────────────────────────
    if [[ "$__repair_workflow_live" == "true" ]]; then
        echo -e "  ${CYAN}○${NC} Skipping artifact check — workflow is running (PID $__repair_workflow_pid)"
    else
        local artifact_files=(
            .claude/spec.md .claude/research.md .claude/current-plan.md .claude/plan-review.md
            .claude/review-pass1-pe.md .claude/review-pass2-pm.md
            .claude/code-review.md .claude/test-report.md .claude/outcome-report.md
            .claude/security-audit.md .claude/verify-report.md .claude/current-test-plan.md
            .claude/phase-result.json .claude/workflow-status.json
        )
        local any_artifacts=false
        local af
        for af in "${artifact_files[@]}"; do
            if [ -f "$af" ]; then
                any_artifacts=true
                __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
                echo -e "  ${YELLOW}⚠${NC} Stale artifact: $af"
                if [[ "$fix_mode" == "true" ]]; then
                    rm -f "$af" || true
                    echo -e "    → Removed"
                else
                    __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                fi
            fi
        done
        if [[ "$any_artifacts" == "false" ]]; then
            echo -e "  ${GREEN}✓${NC} No stale phase artifacts"
        fi
    fi

    # ─── C2: .claude/commands symlink ────────────────────────────────────────────
    local commands_path=".claude/commands"
    local expected_commands="$stored_home/commands"
    if [ ! -L "$commands_path" ] && [ ! -e "$commands_path" ]; then
        # Missing
        __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
        echo -e "  ${YELLOW}⚠${NC} .claude/commands — missing"
        if [[ "$fix_mode" == "true" ]]; then
            ln -s "$expected_commands" "$commands_path" || true
            if [ -L "$commands_path" ]; then
                echo -e "    → Created symlink to $expected_commands"
            else
                echo -e "    ${RED}✗${NC} Failed to create symlink — check permissions"
                __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
            fi
        else
            __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
        fi
    elif [ -L "$commands_path" ]; then
        local cmd_link_target
        cmd_link_target="$(readlink "$commands_path")"
        if [ ! -e "$commands_path" ]; then
            # Broken symlink
            __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
            echo -e "  ${YELLOW}⚠${NC} .claude/commands — broken symlink → $cmd_link_target"
            if [[ "$fix_mode" == "true" ]]; then
                if [[ "$interactive" == "true" ]]; then
                    printf "    Replace with symlink to %s? [y/N] " "$expected_commands"
                    read -r answer
                    if [[ "$answer" == "y" || "$answer" == "Y" ]]; then
                        rm -f "$commands_path"
                        ln -s "$expected_commands" "$commands_path" || true
                        if [ -L "$commands_path" ]; then
                            echo -e "    ${GREEN}✓${NC} Fixed"
                        else
                            echo -e "    ${RED}✗${NC} Failed to create symlink — check permissions"
                            __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                        fi
                    else
                        __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                    fi
                else
                    __REPAIR_SKIPPED_PROMPTED=$((__REPAIR_SKIPPED_PROMPTED + 1))
                    __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                    echo -e "    → Skipped (non-interactive — run \`buildcrew repair --fix\` in a terminal)"
                fi
            else
                __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
            fi
        else
            local norm_cmd="${cmd_link_target%/}"
            local norm_expected_cmd="${expected_commands%/}"
            if [[ "$norm_cmd" != "$norm_expected_cmd" ]]; then
                __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
                echo -e "  ${YELLOW}⚠${NC} .claude/commands — symlink to wrong target"
                echo -e "    Current:  $cmd_link_target"
                echo -e "    Proposed: $expected_commands"
                if [[ "$fix_mode" == "true" ]]; then
                    if [[ "$interactive" == "true" ]]; then
                        printf "    Repoint symlink? [y/N] "
                        read -r answer
                        if [[ "$answer" == "y" || "$answer" == "Y" ]]; then
                            rm -f "$commands_path"
                            ln -s "$expected_commands" "$commands_path" || true
                            if [ -L "$commands_path" ]; then
                                echo -e "    ${GREEN}✓${NC} Fixed"
                            else
                                echo -e "    ${RED}✗${NC} Failed to create symlink — check permissions"
                                __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                            fi
                        else
                            __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                        fi
                    else
                        __REPAIR_SKIPPED_PROMPTED=$((__REPAIR_SKIPPED_PROMPTED + 1))
                        __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                        echo -e "    → Skipped (non-interactive — run \`buildcrew repair --fix\` in a terminal)"
                    fi
                else
                    __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                fi
            else
                echo -e "  ${GREEN}✓${NC} .claude/commands — symlink OK"
            fi
        fi
    else
        # Real directory
        __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
        __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
        echo -e "  ${YELLOW}⚠${NC} .claude/commands — real directory (not a symlink)"
        echo -e "    → Manual review required. Skipping."
    fi

    # ─── C3: .claude/skills/ ─────────────────────────────────────────────────────
    _repair_check_skills "$fix_mode" "$interactive" "$stored_home"

    # ─── C6: .buildcrew/ directory structure ─────────────────────────────────────
    local missing_dirs=()
    [ ! -d ".buildcrew" ] && missing_dirs+=(".buildcrew")
    [ ! -d ".buildcrew/rules" ] && missing_dirs+=(".buildcrew/rules")
    [ ! -d ".buildcrew/context" ] && missing_dirs+=(".buildcrew/context")

    if [[ "${#missing_dirs[@]}" -gt 0 ]]; then
        __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
        local missing_list
        missing_list="${missing_dirs[*]}"
        echo -e "  ${YELLOW}⚠${NC} .buildcrew/ structure — missing: $missing_list"
        if [[ "$fix_mode" == "true" ]]; then
            mkdir -p .buildcrew/rules .buildcrew/context || true
            echo -e "    → Created missing directories"
        else
            __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
        fi
    else
        echo -e "  ${GREEN}✓${NC} .buildcrew/ structure — OK"
    fi

    # ─── C7: Playground plugin ───────────────────────────────────────────────────
    if command -v claude >/dev/null 2>&1; then
        local plugins_json="$HOME/.claude/plugins/installed_plugins.json"
        if ! ([[ -f "$plugins_json" ]] && grep -q '"playground@' "$plugins_json" 2>/dev/null); then
            __REPAIR_ISSUES=$((__REPAIR_ISSUES + 1))
            echo -e "  ${YELLOW}⚠${NC} Playground plugin not installed"
            if [[ "$fix_mode" == "true" ]]; then
                claude plugin marketplace add https://github.com/anthropics/claude-plugins-official >/dev/null 2>&1 || true
                if claude plugin install playground@claude-plugins-official >/dev/null 2>&1; then
                    echo -e "    ${GREEN}✓${NC} Installed playground plugin"
                else
                    echo -e "    ${RED}✗${NC} Failed to install playground plugin"
                    __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
                fi
            else
                __REPAIR_REMAINING=$((__REPAIR_REMAINING + 1))
            fi
        else
            echo -e "  ${GREEN}✓${NC} Playground plugin installed"
        fi
    else
        echo -e "  ${CYAN}○${NC} Playground plugin — claude CLI not found, skipped"
    fi

    # ─── Footer ──────────────────────────────────────────────────────────────────
    echo ""

    if [[ "$__REPAIR_SKIPPED_PROMPTED" -gt 0 ]]; then
        echo "Note: $__REPAIR_SKIPPED_PROMPTED prompted fix(es) skipped — run interactively to resolve."
    fi

    if [[ "$__REPAIR_ISSUES" -eq 0 ]]; then
        echo "All checks passed."
        exit 0
    fi

    if [[ "$fix_mode" == "true" ]]; then
        if [[ "$__REPAIR_REMAINING" -eq 0 ]]; then
            echo "All issues resolved."
            exit 0
        else
            echo "$__REPAIR_REMAINING issue(s) remain (manual review required)."
            exit 1
        fi
    else
        echo "$__REPAIR_ISSUES issue(s) found. Run \`buildcrew repair --fix\` to resolve."
        exit 1
    fi
}

cmd_status() {
    local version
    version=$(get_version)
    echo -e "${BOLD}BuildCrew${NC} v$version"
    echo ""

    if [[ -f "$BACKLOG_FILE" ]]; then
        echo -e "${BOLD}Backlog:${NC}"
        echo "  Pending:   $(count_tasks pending)"
        echo "  Completed: $(count_tasks completed)"
        echo "  Blocked:   $(count_tasks blocked)"
    else
        echo -e "${YELLOW}No BACKLOG.md found.${NC} Run ${CYAN}buildcrew init${NC} to get started."
    fi

    echo ""
    if [[ -f "$STATUS_FILE" ]]; then
        echo -e "${BOLD}Last workflow result:${NC}"
        if parse_status_file "$STATUS_FILE"; then
            case "$__STATUS_RESULT" in
                complete)
                    echo -e "  Status:  ${GREEN}complete${NC}"
                    echo -e "  Summary: $__STATUS_SUMMARY"
                    ;;
                blocked)
                    echo -e "  Status:  ${YELLOW}blocked${NC}"
                    echo -e "  Reason:  $__STATUS_REASON"
                    ;;
            esac
        else
            echo -e "  ${RED}$__STATUS_REASON${NC}"
        fi
    else
        echo -e "${CYAN}No previous workflow run found.${NC}"
    fi
}

cmd_run() {
    # Check for updates (non-blocking)
    check_for_updates &

    # Verify we're in a project with BuildCrew initialized
    if [ ! -f "BACKLOG.md" ]; then
        echo -e "${RED}Error:${NC} No BACKLOG.md found in current directory."
        echo ""
        echo "Either:"
        echo "  1. Run ${CYAN}buildcrew init${NC} to initialize BuildCrew"
        echo "  2. Create a BACKLOG.md file with tasks"
        echo "  3. Use ${CYAN}/build${NC} in Claude Code to generate one"
        exit 1
    fi

    # Show plugin tip on first run
    if ! plugins_already_checked; then
        show_plugin_tip
    fi

    # Pass through to workflow script
    exec "$BUILDCREW_HOME/lib/workflow.sh" "$@"
}

cmd_plan() {
    # Check for updates (non-blocking)
    check_for_updates &

    # Show plugin tip on first run
    if ! plugins_already_checked; then
        show_plugin_tip
    fi

    # Pass --plan flag through to workflow.sh to force discovery mode
    exec "$BUILDCREW_HOME/lib/workflow.sh" --plan "$@"
}

cmd_update() {
    echo -e "${BOLD}Checking for updates...${NC}"
    echo ""

    local current=$(get_version)
    local latest=$(fetch_latest_version)

    if [[ ! "$latest" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo -e "${RED}Error:${NC} Could not fetch latest version. Check your internet connection."
        exit 1
    fi

    if [ "$current" = "$latest" ]; then
        echo -e "${GREEN}✓${NC} BuildCrew is up to date (v$current)"
        exit 0
    fi

    if ! version_lt "$current" "$latest"; then
        echo -e "${GREEN}✓${NC} BuildCrew is up to date (v$current)"
        exit 0
    fi

    echo -e "Update available: ${YELLOW}v$current${NC} → ${GREEN}v$latest${NC}"
    echo ""

    read -p "Install update? [y/N] " -n 1 -r
    echo ""

    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo ""
        echo "Downloading v$latest..."

        local tmp_dir=$(mktemp -d)
        local archive="$tmp_dir/buildcrew.tar.gz"

        curl -fsSL "https://github.com/joshuaccarroll/buildcrew/archive/refs/tags/v$latest.tar.gz" -o "$archive"

        echo "Installing..."
        tar -xzf "$archive" -C "$tmp_dir"

        # Run the installer from the new version
        "$tmp_dir/buildcrew-$latest/install.sh" --upgrade

        rm -rf "$tmp_dir"

        echo ""
        refresh_project_symlinks

        echo ""
        echo -e "${GREEN}✓${NC} Updated to v$latest"

        # Exit immediately — do not fall through into post-update script logic.
        # Safe to execute code after install.sh replaces the script on disk because
        # the entire script is wrapped in { ... } (lines 7-1188), which forces bash
        # to read and parse the full file into memory before executing any of it.
        exit 0
    else
        echo "Update cancelled."
    fi
}

cmd_version() {
    local version=$(get_version)
    echo -e "${BOLD}BuildCrew${NC} v$version"
    echo "https://github.com/joshuaccarroll/buildcrew"
}

cmd_uninstall() {
    echo -e "${BOLD}Uninstalling BuildCrew...${NC}"
    echo ""
    echo "This will remove:"
    echo "  - ~/.buildcrew/"
    echo "  - ~/.local/bin/buildcrew symlink"
    echo ""
    echo -e "${YELLOW}Note:${NC} Project files (.claude/, BACKLOG.md, etc.) will NOT be removed."
    echo ""

    read -p "Continue? [y/N] " -n 1 -r
    echo ""

    if [[ $REPLY =~ ^[Yy]$ ]]; then
        rm -rf "$HOME/.buildcrew"
        rm -f "$HOME/.local/bin/buildcrew"
        rm -f "/usr/local/bin/buildcrew" 2>/dev/null || true

        echo ""
        echo -e "${GREEN}✓${NC} BuildCrew has been uninstalled."
        echo ""
        echo -e "${YELLOW}Note:${NC} If you added BuildCrew to your PATH, remove this line from your shell config:"
        echo -e "  ${CYAN}export PATH=\"\$HOME/.local/bin:\$PATH\"${NC}"
        echo ""
        echo "Common locations: ~/.bashrc, ~/.zshrc, ~/.profile, ~/.bash_profile"
        echo ""
        echo "To reinstall, run:"
        echo "  curl -fsSL https://raw.githubusercontent.com/joshuaccarroll/buildcrew/main/install.sh | bash"
    else
        echo "Uninstall cancelled."
    fi
}

_dash_download_and_run() {
    local script_path="$1"
    shift
    (
        set -e
        local tmp_dir
        tmp_dir=$(mktemp -d)
        trap "rm -rf \"$tmp_dir\"" EXIT
        echo -e "${BOLD}Downloading buildcrew-dash...${NC}"
        if ! curl -fsSL "https://github.com/joshuaccarroll/buildcrew-dash/archive/refs/heads/main.tar.gz" -o "$tmp_dir/buildcrew-dash.tar.gz"; then
            echo "Error: Download failed"
            exit 1
        fi
        tar -xzf "$tmp_dir/buildcrew-dash.tar.gz" -C "$tmp_dir"
        if [[ ! -d "$tmp_dir/buildcrew-dash-main" ]]; then
            echo "Error: Extracted directory not found"
            exit 1
        fi
        "$tmp_dir/buildcrew-dash-main/$script_path" "$@"
    )
}

_dash_install()   { _dash_download_and_run "install.sh"; }
_dash_upgrade()   { _dash_download_and_run "install.sh" --upgrade; }
_dash_uninstall() { _dash_download_and_run "uninstall.sh"; }

# ═══════════════════════════════════════════════════════════════════════════════
# UAT command — blind scenario-based acceptance testing
# ═══════════════════════════════════════════════════════════════════════════════

cmd_uat() {
    local readme_path=""
    local project_name=""
    local artifact_dir=""
    local signal_dir=""
    local uat_auto=false
    local regress_path=""
    local uat_preview=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --readme)
                if [[ -z "${2:-}" ]]; then
                    echo -e "${RED}Error:${NC} --readme requires a path argument"
                    exit 1
                fi
                readme_path="$2"
                shift 2
                ;;
            --project)
                if [[ -z "${2:-}" ]]; then
                    echo -e "${RED}Error:${NC} --project requires a name argument"
                    exit 1
                fi
                project_name="$2"
                shift 2
                ;;
            --artifact-dir)
                if [[ -z "${2:-}" ]]; then
                    echo -e "${RED}Error:${NC} --artifact-dir requires a path argument"
                    exit 1
                fi
                artifact_dir="$2"
                shift 2
                ;;
            --signal-dir)
                if [[ -z "${2:-}" ]]; then
                    echo -e "${RED}Error:${NC} --signal-dir requires a path argument"
                    exit 1
                fi
                signal_dir="$2"
                shift 2
                ;;
            --regress)
                if [[ -z "${2:-}" ]]; then
                    echo -e "${RED}Error:${NC} --regress requires a path argument"
                    exit 1
                fi
                regress_path="$2"
                shift 2
                ;;
            --auto)
                uat_auto=true
                shift
                ;;
            --preview)
                uat_preview=true
                shift
                ;;
            --help|-h)
                echo -e "${BOLD}buildcrew uat${NC} — Blind scenario-based acceptance testing"
                echo ""
                echo -e "${BOLD}USAGE:${NC}"
                echo "    buildcrew uat --readme <path> [options]"
                echo ""
                echo -e "${BOLD}OPTIONS:${NC}"
                echo "    --readme <path>        Path to the project's README.md (required)"
                echo "    --project <name>       Project identifier (default: derived from README parent dir)"
                echo "    --artifact-dir <path>  Where to find the built artifact"
                echo "    --signal-dir <path>    Where to write signal/verdict files"
                echo "    --regress <path>       Run UAT standalone against an existing artifact directory (implies --auto)"
                echo "    --auto                 Auto mode: log disputes without pausing"
                echo "    --preview              List existing scenarios without running agents (read-only)"
                echo "    --help, -h             Show this help message"
                echo ""
                echo -e "${BOLD}EXAMPLES:${NC}"
                echo "    buildcrew uat --readme ../my-project/README.md"
                echo "    buildcrew uat --readme ../my-project/README.md --regress /path/to/artifact"
                echo "    buildcrew uat --preview"
                exit 0
                ;;
            *)
                echo -e "${RED}Error:${NC} Unknown option '$1'"
                echo "Run 'buildcrew uat --help' for usage."
                exit 1
                ;;
        esac
    done

    # Conflict check: --preview + --regress
    if [[ "$uat_preview" == "true" ]] && [[ -n "$regress_path" ]]; then
        echo -e "${RED}Error:${NC} --preview and --regress cannot be used together"
        exit 1
    fi

    # Preview short-circuit (read-only, no --readme required)
    if [[ "$uat_preview" == "true" ]]; then
        source "$BUILDCREW_HOME/lib/uat_signal.sh"
        source "$BUILDCREW_HOME/lib/uat.sh"
        print_header "UAT Preview"
        if [[ ! -d "scenarios" ]]; then
            print_info "No scenarios found. Run 'buildcrew uat --readme <path>' first."
        else
            _uat_list_scenarios
        fi
        exit 0
    fi

    # Validate --readme is provided and readable
    if [[ -z "$readme_path" ]]; then
        echo -e "${RED}Error:${NC} --readme is required"
        echo "Run 'buildcrew uat --help' for usage."
        exit 1
    fi

    if [[ ! -f "$readme_path" ]] || [[ ! -r "$readme_path" ]]; then
        echo -e "${RED}Error:${NC} README not found or not readable: $readme_path"
        exit 1
    fi

    # Derive project name if not provided
    if [[ -z "$project_name" ]]; then
        local abs_readme
        # Use realpath if available, fall back to manual resolution
        if command -v realpath >/dev/null 2>&1; then
            abs_readme="$(realpath "$readme_path")"
        else
            abs_readme="$(cd "$(dirname "$readme_path")" && pwd)/$(basename "$readme_path")"
        fi
        project_name="$(basename "$(dirname "$abs_readme")")"
    fi

    if [[ -z "$project_name" ]]; then
        echo -e "${RED}Error:${NC} Could not derive project name. Use --project <name>."
        exit 1
    fi

    # Validate --regress
    if [[ -n "$regress_path" ]]; then
        # Conflicts with --artifact-dir
        if [[ -n "$artifact_dir" ]]; then
            echo -e "${RED}Error:${NC} --regress and --artifact-dir cannot be used together"
            exit 1
        fi
        # Resolve to absolute path
        if command -v realpath >/dev/null 2>&1; then
            regress_path="$(realpath "$regress_path" 2>/dev/null)" || true
        else
            regress_path="$(cd "$(dirname "$regress_path")" 2>/dev/null && pwd)/$(basename "$regress_path")"
        fi
        # Must be a directory
        if [[ ! -d "$regress_path" ]]; then
            echo -e "${RED}Error:${NC} --regress path is not a directory: $regress_path"
            exit 1
        fi
        # --regress implies --auto
        uat_auto=true
    fi

    # Source UAT libraries
    source "$BUILDCREW_HOME/lib/uat_signal.sh"
    source "$BUILDCREW_HOME/lib/uat.sh"

    # Export variables for uat.sh
    export UAT_README_PATH="$readme_path"
    export UAT_PROJECT_NAME="$project_name"
    export UAT_AUTO_MODE="$uat_auto"
    [[ -n "$artifact_dir" ]] && export UAT_ARTIFACT_DIR_OVERRIDE="$artifact_dir"
    [[ -n "$signal_dir" ]] && export UAT_SIGNAL_DIR_OVERRIDE="$signal_dir"

    # Initialize and run UAT phases
    uat_init "$readme_path" "$project_name"
    uat_run_phases "$readme_path" "$project_name" "$uat_auto" "$regress_path"
}

cmd_dash() {
    local subcommand="${1:-}"

    # Detect installation
    local dash_bin=""
    if [[ -x "$HOME/.buildcrew-dash/.venv/bin/buildcrew-dash" ]]; then
        dash_bin="$HOME/.buildcrew-dash/.venv/bin/buildcrew-dash"
    elif command -v buildcrew-dash &>/dev/null; then
        dash_bin="$(command -v buildcrew-dash)"
    fi

    case "$subcommand" in
        "")
            if [[ -n "$dash_bin" ]]; then
                exec "$dash_bin"
            else
                if [ -t 0 ]; then
                    echo -e "${BOLD}buildcrew-dash${NC} — Terminal dashboard for BuildCrew"
                    echo "buildcrew-dash is not installed."
                    echo ""
                    read -p "Install now? [y/N] " -n 1 -r
                    echo ""
                    if [[ $REPLY =~ ^[Yy]$ ]]; then
                        _dash_install
                    else
                        echo "To install later: buildcrew dash install"
                    fi
                fi
            fi
            ;;
        install)
            if [[ -n "$dash_bin" ]]; then
                echo -e "${YELLOW}Note:${NC} buildcrew-dash is already installed at $dash_bin"
                echo "To update: buildcrew dash update"
                exit 0
            fi
            _dash_install
            ;;
        update)
            if [[ -z "$dash_bin" ]]; then
                echo -e "${RED}Error:${NC} buildcrew-dash is not installed."
                echo "Install with: buildcrew dash install"
                exit 1
            fi
            _dash_upgrade
            ;;
        uninstall)
            if [[ -z "$dash_bin" ]]; then
                echo -e "${RED}Error:${NC} buildcrew-dash is not installed."
                echo "Install with: buildcrew dash install"
                exit 1
            fi
            _dash_uninstall
            ;;
        status)
            if [[ -n "$dash_bin" ]]; then
                echo -e "${GREEN}Installed:${NC} $dash_bin"
                local pyproject="$HOME/.buildcrew-dash/pyproject.toml"
                local version=""
                if [[ -f "$pyproject" ]]; then
                    version=$(grep '^version = "' "$pyproject" | head -1 | sed 's/.*"\(.*\)".*/\1/')
                fi
                if [[ -z "$version" ]]; then
                    version="version unknown"
                fi
                echo "$version"
            else
                echo -e "${YELLOW}Not installed${NC}"
                echo "Install with: buildcrew dash install"
            fi
            ;;
        --help|-h|help)
            echo -e "${BOLD}buildcrew dash${NC} — Manage the buildcrew-dash terminal dashboard"
            echo ""
            echo "USAGE:"
            echo "    buildcrew dash [subcommand]"
            echo ""
            echo "SUBCOMMANDS:"
            echo "    install      Download and install buildcrew-dash"
            echo "    update       Update buildcrew-dash to the latest version"
            echo "    uninstall    Remove buildcrew-dash"
            echo "    status       Show installation status and version"
            echo "    help         Show this help message"
            echo ""
            echo "Run 'buildcrew dash' with no arguments to launch the TUI (if installed)."
            ;;
        *)
            echo -e "${RED}Error: Unknown dash subcommand '$subcommand'${NC}"
            echo "Run 'buildcrew dash help' for usage."
            exit 1
            ;;
    esac
}

# Main command dispatch
case "${1:-}" in
    init)
        shift
        cmd_init "$@"
        ;;
    run)
        shift
        cmd_run "$@"
        ;;
    plan)
        shift
        cmd_plan "$@"
        ;;
    status)
        cmd_status
        ;;
    stop)
        cmd_stop
        ;;
    reset)
        cmd_reset
        ;;
    repair)
        shift
        cmd_repair "$@"
        ;;
    lessons)
        shift
        cmd_lessons "$@"
        ;;
    plugins)
        shift
        cmd_plugins "$@"
        ;;
    update)
        shift
        cmd_update "$@"
        ;;
    uat)
        shift
        source "$BUILDCREW_HOME/lib/uat_signal.sh"
        source "$BUILDCREW_HOME/lib/uat.sh"
        cmd_uat "$@"
        ;;
    dash)
        shift
        cmd_dash "$@"
        ;;
    version|--version|-v)
        cmd_version
        ;;
    uninstall)
        cmd_uninstall
        ;;
    help|--help|-h|"")
        print_help
        ;;
    *)
        echo -e "${RED}Error:${NC} Unknown command '$1'"
        echo ""
        echo "Run 'buildcrew help' for usage information."
        exit 1
        ;;
esac
}
